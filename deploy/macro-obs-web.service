# PWA 웹서버 systemd 유닛 (LAN/테일넷 전용 — 공인망 노출 금지)
# sudo cp deploy/macro-obs-web.service /etc/systemd/system/
# sudo systemctl daemon-reload && sudo systemctl enable --now macro-obs-web
[Unit]
Description=macro-obs web (PWA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/macro-obs
ExecStart=/usr/bin/node --no-warnings --no-network-family-autoselection src/jobs/server.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
