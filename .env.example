# 한국은행 ECOS — https://ecos.bok.or.kr/api/ 에서 발급 (무료, 즉시)
ECOS_API_KEY=발급받은키

# 텔레그램 — @BotFather로 봇 생성 후 토큰,
# 봇에게 아무 메시지 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TG_BOT_TOKEN=123456:ABC...
TG_CHAT_ID=123456789

# 선택
# DB_PATH=/home/pi/macro-obs/db/macro.db
# ALERT_COOLDOWN_DAYS=7
# DRY_RUN=1   # 텔레그램 발송 대신 콘솔 출력

# DART Open API — https://opendart.fss.or.kr 발급 (무료)
DART_API_KEY=발급받은키

# 노출 추출 모드: claude(기본, 파이의 Claude Code 헤드리스) | manual(프롬프트 파일로 떨굼)
# EXTRACT_MODE=claude
# cron/systemd의 PATH가 짧아도 동작하도록 Claude CLI 절대경로를 지정할 수 있음.
# CLAUDE_BIN=/home/pi/.local/bin/claude
# 기본은 haiku로 추출하고 검증 실패 시 sonnet 승급. 지정하면 해당 모델로 고정.
# EXTRACT_MODEL=sonnet
# DART 원문 검색 도구를 허용하는 에이전트 모드 (모델 사다리는 동일하게 적용)
# EXTRACT_AGENT=1
# 발췌 다이어트 기본값. 품질 회귀 시 1500/45000으로 되돌릴 수 있음.
# DART_EXCERPT_RADIUS=900
# DART_EXCERPT_MAX=30000

# FRED — https://fred.stlouisfed.org/docs/api/api_key.html 발급 (무료). 없으면 글로벌 지표 수집 스킵.
FRED_API_KEY=발급받은키

# UN Comtrade — https://comtradeplus.un.org 무료 구독키. HHI 검증(연 1~2회)용, 없으면 스킵.
COMTRADE_API_KEY=발급받은키

# 네이버 검색 API — developers.naver.com 애플리케이션 등록 (무료). 뉴스 프레이밍(Phase 5)용.
NAVER_CLIENT_ID=발급받은ID
NAVER_CLIENT_SECRET=발급받은시크릿

# MCP 3층 — HTTP 쓰기 도구 게이트. 미설정 시 HTTP는 영구 읽기 전용 (stdio는 항상 전체).
# MCP_WRITE_TOKEN=openssl rand -hex 24 로 생성한 긴 무작위 문자열

# 공인망(클라우드플레어 터널) 접근용 Bearer 토큰. 미설정이면 터널 요청은 전부 401.
# 허용 경로: /api/events, /api/track, /mcp(읽기 전용). 생성: openssl rand -hex 32
# PUBLIC_API_TOKEN=
# 공인망 MCP에 노출할 읽기 도구 (기본값)
# PUBLIC_MCP_TOOLS=get_events,get_track,search_news

# OAuth (원격 MCP 커넥터). 승인 화면은 Cloudflare Access 뒤 — 서버가 Access JWT를 직접 검증 (셋 중 하나라도 비면 승인 불가)
# PUBLIC_BASE_URL=https://macro.example.com
# CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
# CF_ACCESS_AUD=
# OAUTH_OWNER_EMAIL=
